# ── QUEEN BEE ROOT HIVE ──────────────────────────────────────────────────────
# Both agents are LIVE-REGISTERED on Moltbook (Feb 26 2026).
# Claim them using the URLs in hive/credentials/moltbook.json (gitignored).
# SOL-V profile: https://www.moltbook.com/u/sol-v
# ECHO profile:  https://www.moltbook.com/u/echo-sing9
# After claiming, copy keys from hive/credentials/moltbook.json into .env
# and set MOLTBOOK_MOCK=false to go live.

# MOCK MODE — flip to false once claimed + keys added to .env
MOLTBOOK_MOCK=true

# ORACLE bypass — Commander direct unlock while claim is pending
MOLTBOOK_COMMANDER_BYPASS=true

# Your service app key (for verifying incoming agent tokens)
MOLTBOOK_APP_KEY=

# SOL-V registered key — moltbook_sk_... (see hive/credentials/moltbook.json)
MOLTBOOK_SOLV_API_KEY=

# ECHO registered key — moltbook_sk_... (see hive/credentials/moltbook.json)
MOLTBOOK_ECHO_API_KEY=

# Moltbook base URL — always use www (no-www strips Authorization header!)
MOLTBOOK_BASE_URL=https://www.moltbook.com

# APEX channel config
APEX_CHANNEL=telegram
APEX_TELEGRAM_BOT_TOKEN=
APEX_COMMANDER_ID=
APEX_LATTICE_PATH=./hive/LATTICE.json

# SYNC solar monitoring
SYNC_POLL_INTERVAL_MS=900000
SYNC_AR_TARGET=AR4379
SYNC_EGS_CONSTANT=0.0032
SYNC_THERMAL_TARGET=83.0
SYNC_LATTICE_PATH=./hive/LATTICE.json

# EGS Fractal Constant — GOLDEN KEY — INTERNAL ONLY
# NEVER expose this in public Moltbook posts, comments, or profiles.
# MoltbookProtocol.ts scrubs this automatically via scrubGoldenKey().
EGS_FRACTAL_CONSTANT=0.0032

# ORACLE settings
ORACLE_MIN_ENGAGEMENT=10000
ORACLE_MAIP_OUTPUT_DIR=./hive/swarm/oracle/maips/
ORACLE_COMMANDER_EMAIL=info@fractiai.com
ORACLE_PAYMENT_VENMO=@Pru-Mendez
ORACLE_PAYMENT_CASHAPP=$newearthpru
