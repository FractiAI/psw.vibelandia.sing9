# Copy to .env and fill. .env is gitignored. For Vercel, add these in Project → Settings → Environment Variables.

# ── SOLVER: ZERO HUMAN INTERVENTION PRIZE ENGINE ────────────────────────────
# Fetches open coding bounties (Algora/IssueHunt/Gitcoin), Claude writes the fix,
# GitHub API submits the PR. Payment releases automatically when PR is merged.
#
# Step 1: GitHub token with repo + workflow scopes
#   → github.com/settings/tokens → Generate new token (classic)
#   → Select scopes: repo (full), workflow
GITHUB_TOKEN=

# Step 2: Anthropic API key (Claude solves the issues)
#   → console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Step 3: Payout — at least one of these (where bounty platforms send payment)
#   Algora/Gitcoin: crypto wallet (ETH/USDC)
WALLET_ADDRESS=
#   IssueHunt/Bountysource: USD via PayPal/bank
PAYOUT_EMAIL=

# Minimum bounty to attempt (default $100 — not worth Claude compute for less)
MIN_BOUNTY_USD=100

# Max PRs to open per solver cycle (default 3 — quality over quantity)
SOLVER_MAX_ATTEMPTS=3

# ── ELASTICSEARCH — ELASTIC HIVE INTELLIGENCE LAYER ─────────────────────────
# When set, the outbound engine upgrades from keyword heuristics to
# kNN semantic matching + ES|QL pipeline analytics (zero-code change).
#
# Get free 14-day Elasticsearch Cloud trial (no credit card):
#   → cloud.elastic.co → Start free trial → Create deployment
#   → Copy Cloud ID + create API Key (Security → API Keys)
ES_CLOUD_ID=
ES_API_KEY=
# OR for local Elasticsearch:
# ES_NODE=http://localhost:9200
GROQ_API_KEY=
GROQ_API_KEY_ALT=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VIBELANDIA_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
VIBELANDIA_SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VIBELANDIA_SUPABASE_ANON_KEY=

STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

VERCEL_TOKEN=
VERCEL_DOMAIN=

METAMASK_WALLET=
NEXT_PUBLIC_METAMASK_WALLET=

# ── ZHI MICROTRANSACTION ENGINE — x402 + A2A INTAKE ────────────────────────
# Receiving wallet for all x402 and USDC-on-chain payments.
# Must match the address in api/_x402.js and public/agent.json.
# Set this in Vercel: Project → Settings → Environment Variables
WALLET_USDC_BASE=0x3563388d0e1c2d66a004e5e57717dc6d7e568be3

# Anthropic Claude — powers instant delivery in /api/a2a-intake
# Without this, auto-tier services queue instead of delivering instantly.
# console.anthropic.com → API Keys → Create key
# CRITICAL: add this to Vercel env vars too — not just .env
ANTHROPIC_API_KEY=

# x402 testnet mode — set true for testing on Base Sepolia (fake USDC)
X402_TESTNET=false

# ── QUEEN BEE ROOT HIVE ──────────────────────────────────────────────────────
# ZHI pipes: Resend email + x402 + a2a-intake. No platform claims required.

# MOCK MODE — flip to false for live outbound
ZHI_MOCK=true

# ORACLE bypass — Commander direct unlock
COMMANDER_BYPASS=true

# ECHO trial engine — force active for testing
ECHO_TRIAL_FORCE=false

# APEX channel config
APEX_CHANNEL=telegram
APEX_TELEGRAM_BOT_TOKEN=
APEX_COMMANDER_ID=
APEX_LATTICE_PATH=./hive/LATTICE.json

# SYNC solar monitoring
SYNC_POLL_INTERVAL_MS=900000
SYNC_AR_TARGET=AR4379
SYNC_EGS_CONSTANT=0.0032
SYNC_THERMAL_TARGET=83.0
SYNC_LATTICE_PATH=./hive/LATTICE.json

# ── BLUESKY — ELIMINATED (requires human account creation — not ZHI) ─────────
# BSKY_HANDLE=
# BSKY_APP_PASSWORD=

# ── X / TWITTER — ELIMINATED ─────────────────────────────────────────────────
# X API Basic = $100/month. Not free. Not water. Not NSPFRNP. Eliminated Mar 1 2026.
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=

# ── EGS Fractal Constant — GOLDEN KEY — INTERNAL ONLY ────────────────────────
# NEVER expose this in public posts, comments, or outbound messages.
# scrubGoldenKey() in run.js scrubs this automatically on every outbound message.
EGS_FRACTAL_CONSTANT=0.0032

# ORACLE settings
ORACLE_MIN_ENGAGEMENT=10000
ORACLE_MAIP_OUTPUT_DIR=./hive/swarm/oracle/maips/
ORACLE_COMMANDER_EMAIL=info@fractiai.com
ORACLE_PAYMENT_VENMO=@Pru-Mendez
ORACLE_PAYMENT_CASHAPP=$newearthpru
