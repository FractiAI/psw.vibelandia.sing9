# Copy to .env and fill. .env is gitignored. For Vercel, add these in Project → Settings → Environment Variables.

# ── SOLVER: ZERO HUMAN INTERVENTION PRIZE ENGINE ────────────────────────────
# Fetches open coding bounties (Algora/IssueHunt/Gitcoin), Claude writes the fix,
# GitHub API submits the PR. Payment releases automatically when PR is merged.
#
# Step 1: GitHub token with repo + workflow scopes
#   → github.com/settings/tokens → Generate new token (classic)
#   → Select scopes: repo (full), workflow
GITHUB_TOKEN=

# Step 2: Anthropic API key (Claude solves the issues)
#   → console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Step 3: Payout — at least one of these (where bounty platforms send payment)
#   Algora/Gitcoin: crypto wallet (ETH/USDC)
WALLET_ADDRESS=
#   IssueHunt/Bountysource: USD via PayPal/bank
PAYOUT_EMAIL=

# Minimum bounty to attempt (default $100 — not worth Claude compute for less)
MIN_BOUNTY_USD=100

# Max PRs to open per solver cycle (default 3 — quality over quantity)
SOLVER_MAX_ATTEMPTS=3

# ── ELASTICSEARCH — ELASTIC HIVE INTELLIGENCE LAYER ─────────────────────────
# When set, the outbound engine upgrades from keyword heuristics to
# kNN semantic matching + ES|QL pipeline analytics (zero-code change).
#
# Get free 14-day Elasticsearch Cloud trial (no credit card):
#   → cloud.elastic.co → Start free trial → Create deployment
#   → Copy Cloud ID + create API Key (Security → API Keys)
ES_CLOUD_ID=
ES_API_KEY=
# OR for local Elasticsearch:
# ES_NODE=http://localhost:9200
GROQ_API_KEY=
GROQ_API_KEY_ALT=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VIBELANDIA_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
VIBELANDIA_SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VIBELANDIA_SUPABASE_ANON_KEY=

STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

VERCEL_TOKEN=
VERCEL_DOMAIN=

METAMASK_WALLET=
NEXT_PUBLIC_METAMASK_WALLET=

# ── QUEEN BEE ROOT HIVE ──────────────────────────────────────────────────────
# Both agents are LIVE-REGISTERED on Moltbook (Feb 26 2026).
# Claim them using the URLs in hive/credentials/moltbook.json (gitignored).
# SOL-V profile: https://www.moltbook.com/u/sol-v
# ECHO profile:  https://www.moltbook.com/u/echo-sing9
# After claiming, copy keys from hive/credentials/moltbook.json into .env
# and set MOLTBOOK_MOCK=false to go live.

# MOCK MODE — flip to false once claimed + keys added to .env
MOLTBOOK_MOCK=true

# ORACLE bypass — Commander direct unlock while claim is pending
MOLTBOOK_COMMANDER_BYPASS=true

# Your service app key (for verifying incoming agent tokens)
MOLTBOOK_APP_KEY=

# QUEEN BEE ROOT — broadcast node, HHL Source, hive governor
# profile: https://www.moltbook.com/u/queenbeeroot
MOLTBOOK_QB_API_KEY=

# SOL-V outbound A2A sales agent — registered key (see hive/credentials/moltbook.json)
# profile: https://www.moltbook.com/u/sol-v
MOLTBOOK_SOLV_API_KEY=

# ECHO counter-intel node — registered key (see hive/credentials/moltbook.json)
# profile: https://www.moltbook.com/u/echo-sing9
MOLTBOOK_ECHO_API_KEY=

# Moltbook base URL — always use www (no-www strips Authorization header!)
MOLTBOOK_BASE_URL=https://www.moltbook.com

# APEX channel config
APEX_CHANNEL=telegram
APEX_TELEGRAM_BOT_TOKEN=
APEX_COMMANDER_ID=
APEX_LATTICE_PATH=./hive/LATTICE.json

# SYNC solar monitoring
SYNC_POLL_INTERVAL_MS=900000
SYNC_AR_TARGET=AR4379
SYNC_EGS_CONSTANT=0.0032
SYNC_THERMAL_TARGET=83.0
SYNC_LATTICE_PATH=./hive/LATTICE.json

# ── X / TWITTER — QUEEN BEE BROADCAST CHANNEL ───────────────────────────────
# Repurpose your existing X account as the hive's A2A broadcast channel.
# Get keys at: https://developer.twitter.com/en/portal/dashboard
# → Create a Project + App → Keys and Tokens → generate all 4 below.
# Free tier (Essential) is enough — allows 1,500 tweets/month.

X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ── EGS Fractal Constant — GOLDEN KEY — INTERNAL ONLY ────────────────────────
# NEVER expose this in public Moltbook posts, comments, or profiles.
# MoltbookProtocol.ts scrubs this automatically via scrubGoldenKey().
EGS_FRACTAL_CONSTANT=0.0032

# ORACLE settings
ORACLE_MIN_ENGAGEMENT=10000
ORACLE_MAIP_OUTPUT_DIR=./hive/swarm/oracle/maips/
ORACLE_COMMANDER_EMAIL=info@fractiai.com
ORACLE_PAYMENT_VENMO=@Pru-Mendez
ORACLE_PAYMENT_CASHAPP=$newearthpru
