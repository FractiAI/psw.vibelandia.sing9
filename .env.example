# Copy to .env and fill. .env is gitignored. For Vercel, add these in Project → Settings → Environment Variables.

GITHUB_TOKEN=
GROQ_API_KEY=
GROQ_API_KEY_ALT=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VIBELANDIA_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
VIBELANDIA_SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VIBELANDIA_SUPABASE_ANON_KEY=

STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

VERCEL_TOKEN=
VERCEL_DOMAIN=

METAMASK_WALLET=
NEXT_PUBLIC_METAMASK_WALLET=

# ── QUEEN BEE ROOT HIVE ──────────────────────────────────────────────────────
# Apply for early access at moltbook.com/developers to get moltdev_ keys.
# While waiting for keys: set MOLTBOOK_MOCK=true — hive runs in simulation,
# posts queue internally and fire the moment you flip MOLTBOOK_MOCK=false.

# MOCK MODE — set true while waiting for moltdev_ keys
MOLTBOOK_MOCK=true

# ORACLE bypass — Commander direct unlock while key is pending (remove once key is live)
MOLTBOOK_COMMANDER_BYPASS=true

# Your service app key (for verifying incoming agent tokens)
MOLTBOOK_APP_KEY=moltdev_

# SOL-V's own bot key (Node 9 · ⬡ · A2A closer)
MOLTBOOK_SOLV_API_KEY=moltdev_

# ECHO's own bot key (Node 4 · ≋ · Counter-intel)
MOLTBOOK_ECHO_API_KEY=moltdev_

# Moltbook base URL (do not change unless using a staging environment)
MOLTBOOK_BASE_URL=https://www.moltbook.com

# APEX channel config
APEX_CHANNEL=telegram
APEX_TELEGRAM_BOT_TOKEN=
APEX_COMMANDER_ID=
APEX_LATTICE_PATH=./hive/LATTICE.json

# SYNC solar monitoring
SYNC_POLL_INTERVAL_MS=900000
SYNC_AR_TARGET=AR4379
SYNC_EGS_CONSTANT=0.0032
SYNC_THERMAL_TARGET=83.0
SYNC_LATTICE_PATH=./hive/LATTICE.json

# EGS Fractal Constant — GOLDEN KEY — INTERNAL ONLY
# NEVER expose this in public Moltbook posts, comments, or profiles.
# MoltbookProtocol.ts scrubs this automatically via scrubGoldenKey().
EGS_FRACTAL_CONSTANT=0.0032

# ORACLE settings
ORACLE_MIN_ENGAGEMENT=10000
ORACLE_MAIP_OUTPUT_DIR=./hive/swarm/oracle/maips/
ORACLE_COMMANDER_EMAIL=info@fractiai.com
ORACLE_PAYMENT_VENMO=@Pru-Mendez
ORACLE_PAYMENT_CASHAPP=$newearthpru
