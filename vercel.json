{
  "version": 2,
  "name": "psw-vibelandia-sing9",
  "framework": null,
  "buildCommand": "node scripts/vercel-static-output.mjs",
  "outputDirectory": "dist",
  "crons": [
    { "path": "/api/cron", "schedule": "0 */2 * * *" }
  ],
  "rewrites": [
    { "source": "/.well-known/agent.json", "destination": "/api/agent" },
    { "source": "/.well-known/ai-plugin.json", "destination": "/api/agent" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Protocol", "value": "NSPFRNP" },
        { "key": "X-Octave-0", "value": "Seed" },
        { "key": "X-Octave-1", "value": "Edge" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, X-PAYMENT, X-402-Payment, Authorization, Payment" }
      ]
    }
  ]
}
