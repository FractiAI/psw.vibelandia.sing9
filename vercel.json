{
  "version": 2,
  "name": "psw-vibelandia-sing9",
  "framework": null,
  "buildCommand": "node scripts/generate-static-endpoints.mjs && node scripts/generate-demo-report.mjs && node scripts/vercel-static-output.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/run-zero-dish-test.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/live-houdini-readings.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/magic-trick", "destination": "/magic-trick.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Protocol", "value": "NSPFRNP" },
        { "key": "X-Octave-0", "value": "Seed" },
        { "key": "X-Octave-1", "value": "Edge" }
      ]
    }
  ]
}
