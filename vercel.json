{
  "version": 2,
  "name": "psw-vibelandia-sing9",
  "framework": null,
  "buildCommand": "node scripts/generate-static-endpoints.mjs && node scripts/generate-demo-report.mjs && node scripts/vercel-static-output.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/live-houdini-readings.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/blank-stone-hydrogen.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/schumann-equinox-probe.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/jovian-hydrogen-line-probe.js": {
      "memory": 128,
      "maxDuration": 15
    },
    "api/stryker-equinox-probe.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/firmware-180-spin-probe.js": {
      "memory": 128,
      "maxDuration": 15
    },
    "api/g5-surf-protocol.js": {
      "memory": 128,
      "maxDuration": 15
    },
    "api/magic-trick-telemetry.js": {
      "memory": 128,
      "maxDuration": 25
    }
  },
  "rewrites": [
    { "source": "/magic-trick", "destination": "/magic-trick.html" },
    { "source": "/fractiai/digital-pru", "destination": "/interfaces/fractiai-digital-pru.html" },
    { "source": "/fractiai/digital-pru/", "destination": "/interfaces/fractiai-digital-pru.html" },
    { "source": "/interfaces/fractiai/digital-pru", "destination": "/interfaces/fractiai-digital-pru.html" },
    { "source": "/interfaces/fractiai/digital-pru/", "destination": "/interfaces/fractiai-digital-pru.html" },
    { "source": "/interfaces/sing9-edge-onboarding", "destination": "/interfaces/sing9-light-edge-onboarding.html" },
    { "source": "/interfaces/sing9-edge-onboarding/", "destination": "/interfaces/sing9-light-edge-onboarding.html" },
    { "source": "/sing9-light-edge-onboarding", "destination": "/interfaces/sing9-light-edge-onboarding.html" },
    { "source": "/sing9-light-edge-onboarding/", "destination": "/interfaces/sing9-light-edge-onboarding.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Protocol", "value": "NSPFRNP" },
        { "key": "X-Octave-0", "value": "Seed" },
        { "key": "X-Octave-1", "value": "Edge" }
      ]
    }
  ]
}
